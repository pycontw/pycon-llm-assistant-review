          <mxGeometry x="80" y="1500" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2_5_script" value="人類 reviewer 在 Metabase&#10;用 diff 報告快速判斷&#10;「投稿者有沒有針對 Stage 1 意見改進」&#10;然後重新投票&#10;&#10;⚠️ 不在 codebase 內，無 script" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="500" y="1500" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s2_5_out" value="（最終投票結果在 Metabase，&#10;不會回流到 repo 的 output/）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="980" y="1520" width="380" height="60" as="geometry" />
        </mxCell>

        <mxCell id="key_insight" value="🔑 關鍵觀察&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;1. Stage 1 / Stage 2 的 review、categorize 用**同一支 script**，差別只在 input 檔名跟 output 日期戳（model 也升級了，但這是執行參數，不是流程設計）&#10;2. 唯一「stage 感知」的步驟是 run_proposal_diff.py：必須同時輸入 stage1 + stage2 兩個 xlsx&#10;3. 中間期（投稿者改稿）完全不在 codebase 內，靠 Metabase&#10;4. 真人投票結果留在 Metabase，不會回流到 repo——LLM output 跟人類 vote 是兩個獨立的儲存體" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4c3;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="1640" width="1620" height="180" as="geometry" />
        </mxCell>

        <mxCell id="caveat" value="⚠️ 推論 vs 驗證的免責聲明&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;✅ 程式行為（script、output 命名、預設參數、prompt placeholders）：均經 fact-check（見 Page 2）&#10;⚠️ 哪份 xlsx 對應「Stage 1 / Stage 2」是依據檔名 + README:111-115 的範例 + 檔案 mtime 推論&#10;⚠️ 4/27→5/20 是「投稿者改稿期」是依 PyCon 審稿慣例 + 檔案時間戳推論，codebase 沒明說&#10;❌ 4/12 categorize 比 4/7 review 晚 5 天，原因不確定（可能是 prompt 還在迭代）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="1840" width="1620" height="160" as="geometry" />
        </mxCell>

