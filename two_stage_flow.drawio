  <diagram name="Fact-Check Evidence" id="page2">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title2" value="Fact-Check Evidence Table（每個聲稱都可獨立驗證）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="1100" height="40" as="geometry" />
        </mxCell>

        <mxCell id="confidence_legend" value="信心分級&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;✅ 程式碼直接 cite — 行為由 source code 決定，不會錯&#10;📂 檔案系統實證 — 用 ls 直接看到，size 跟 mtime 都對得起來&#10;⚠️  推論 — 從檔名慣例 / 時間戳 / README 範例組合推出，需人為複核" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1620" height="120" as="geometry" />
        </mxCell>

        <mxCell id="evidence_section1" value="✅ 程式碼直接 cite（高信心）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="1620" height="30" as="geometry" />
        </mxCell>

        <mxCell id="ev1" value="聲稱：Metabase database id = 12&#10;cite：src/config.py:70  →  METABASE_DATABASE_ID = 12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="800" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ev2" value="聲稱：get_2025_proposals.py 寫到 data/pycontw_2025_proposals_&lt;DATE&gt;.xlsx&#10;cite：src/get_2025_proposals.py:27,30&#10;  output_dir = &quot;data&quot;&#10;  output_file = os.path.join(output_dir, f&quot;pycontw_2025_proposals_{timestamp}.xlsx&quot;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="860" y="260" width="800" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ev3" value="聲稱：run_llm.py review 預設輸出 output/llm_review_&lt;model&gt;_&lt;DATE&gt;.xlsx&#10;cite：src/main_llm.py:138&#10;  output_file = output_dir / f&quot;llm_review_{args.model}_{date_str}.xlsx&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="800" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ev4" value="聲稱：run_categorize.py 預設輸出 output/proposal_categories_&lt;model&gt;_&lt;DATE&gt;.xlsx&#10;cite：run_categorize.py:72&#10;  output_file = output_dir / f&quot;proposal_categories_{args.model}_{date_str}.xlsx&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="860" y="360" width="800" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ev5" value="聲稱：run_proposal_diff.py 預設輸出 output/proposal_diff_&lt;model&gt;_&lt;DATE&gt;.xlsx&#10;cite：run_proposal_diff.py:75&#10;  output_file = output_dir / f&quot;proposal_diff_{args.model}_{date_str}.xlsx&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="800" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ev6" value="聲稱：diff prompt 同時用 {stage1_*} + {stage2_*} 各 5 個 placeholder&#10;cite：prompt/proposal_diff_prompt.txt:6-10, 13-17&#10;  {stage1_title} {stage1_abstract} {stage1_detailed_description} {stage1_outline} {stage1_objective}&#10;  {stage2_title} {stage2_abstract} {stage2_detailed_description} {stage2_outline} {stage2_objective}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="860" y="450" width="800" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ev7" value="聲稱：&quot;stage&quot; 字面只出現在 main_llm.py 跟 proposal_diff.py（其他模組無 stage 概念）&#10;cite：grep -rn stage src/ run_*.py prompt/ → 命中只在&#10;  src/main_llm.py:97-99, 283-302（diff 子指令參數）&#10;  src/llm/proposal_diff.py:40-91, 110-120&#10;  prompt/proposal_diff_prompt.txt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1620" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ev8" value="聲稱：full_prompt.txt 只有一個 {PROPOSAL_INFO} placeholder（review 不知道任何 reviewer comment）&#10;cite：prompt/full_prompt.txt 結尾&#10;  以下是proposal 的資訊：&#10;  {PROPOSAL_INFO}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1620" height="80" as="geometry" />
        </mxCell>

        <mxCell id="evidence_section2" value="📂 檔案系統實證（中信心 — 檔案存在 + size + mtime 都驗過）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="1620" height="30" as="geometry" />
        </mxCell>

        <mxCell id="ev_files" value="檔名（含 mtime + size）&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;data/pycontw_2025_proposals_20250407.xlsx               178 KB  mtime 4/7&#10;data/pycontw_2025_proposals_snapshot_20250427.xlsx     229 KB  mtime 5/25 ⚠️ mtime 跟檔名日期不一致&#10;data/pycontw_2025_proposals_20250520.xlsx              203 KB  mtime 5/20&#10;output/llm_review_o3-mini_20250407.xlsx                 95 KB  mtime 4/7&#10;output/llm_review_o4-mini_20250520.xlsx                125 KB  mtime 5/20&#10;output/proposal_categories_o3-mini_20250412.xlsx        26 KB  mtime 4/12&#10;output/proposal_categories_o4-mini_20250520.xlsx        23 KB  mtime 5/20&#10;output/proposal_diff_o4-mini_20250525.xlsx              48 KB  mtime 5/25&#10;&#10;驗證指令：ls -la data/&lt;files&gt; output/&lt;files&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="1620" height="240" as="geometry" />
        </mxCell>

        <mxCell id="evidence_section3" value="⚠️ 推論（低信心 — 需人為複核）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;align=left;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="1620" height="30" as="geometry" />
        </mxCell>

        <mxCell id="inf1" value="推論：snapshot_20250427.xlsx = Stage 1 凍結快照&#10;依據：(1) 檔名有 _snapshot_ 後綴；(2) README:111-115 範例就是把它當 --stage1_file 用&#10;風險：如果別人對「Stage 1」的定義不同（例如指 4/7 第一輪），這裡會搞錯" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="1620" height="70" as="geometry" />
        </mxCell>
        <mxCell id="inf2" value="推論：4/27→5/20 是「投稿者改稿期」&#10;依據：(1) 兩份檔案 mtime 差距 + (2) PyCon 一般審稿流程（初審 → 給意見 → 改稿 → 複審）&#10;風險：codebase 完全沒這段註解；可能其實是「reviewer 內部討論期」之類，需跟程序組確認" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="1210" width="1620" height="70" as="geometry" />
        </mxCell>
        <mxCell id="inf3" value="推論：4/12 categorize 比 4/7 review 晚 5 天的原因&#10;依據：純粹從 mtime 觀察&#10;風險：可能是 prompt 還在迭代、可能是 reviewer 只在某時間點需要 category、可能是分工問題；不確定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="1300" width="1620" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
