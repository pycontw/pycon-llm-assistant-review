  <diagram name="Issues Summary" id="page3">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title3" value="Known Issues / Footguns（含 cite）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="600" height="40" as="geometry" />
        </mxCell>

        <mxCell id="i1" value="⚠️ 1 — diff 子指令重複實作&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;src/main_llm.py:96-110 (subparser) + :267-312 (execute_diff)&#10;run_proposal_diff.py:37-109&#10;→ 兩條 CLI 都呼叫 run_proposal_diff_analysis_sync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="640" height="120" as="geometry" />
        </mxCell>

        <mxCell id="i2" value="⚠️ 2 — Model 家族分支邏輯出現兩次&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;src/llm/review.py:60-67  (LangChain)&#10;src/llm/client.py:83-95  (裸 SDK)&#10;→ 規則不一致（路徑 B 沒有 Gemini）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="720" y="80" width="640" height="120" as="geometry" />
        </mxCell>

        <mxCell id="i3" value="⚠️ 3 — 兩種 LLM 呼叫風格並存&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;LangChain：src/llm/review.py:11-13&#10;裸 SDK：src/llm/client.py:9 (AsyncOpenAI)&#10;→ retry / 錯誤處理 / close 各一套" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="640" height="120" as="geometry" />
        </mxCell>

        <mxCell id="i4" value="⚠️ 4 — Import 風格混用&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;有 src. 前綴：&#10;  src/llm/review.py:15-16, src/evaluation/evaluator.py:13-14&#10;  run_categorize.py:13-14&#10;無 src. 前綴：&#10;  src/main_llm.py:12-14, src/llm/proposal_diff.py:14-15&#10;  run_proposal_diff.py:23-24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="720" y="220" width="640" height="180" as="geometry" />
        </mxCell>

        <mxCell id="i5" value="⚠️ 5 — sys.path 手動插入分散在四處&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;run_llm.py:11-14&#10;run_proposal_diff.py:11-14&#10;src/db/connector.py:13-15&#10;src/get_2025_proposals.py:5-8&#10;→ 沒有 setup.py / pyproject.toml 統一管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="640" height="140" as="geometry" />
        </mxCell>

        <mxCell id="i6" value="⚠️ 6 — OPENAI_TEMPERATURE=0 設了沒人讀&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;設定處：run_llm.py:17, run_proposal_diff.py:17&#10;但實作寫死：&#10;  src/llm/review.py:63 (temperature=0)&#10;  src/llm/client.py:87 (temperature=0)&#10;→ 看起來像可調，其實是死的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="720" y="420" width="640" height="160" as="geometry" />
        </mxCell>

        <mxCell id="i7" value="⚠️ 7 — logging.basicConfig 重複呼叫&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;src/main_llm.py:18-25, src/llm/review.py:20-27&#10;src/db/connector.py:23-30, src/evaluation/evaluator.py:17-20&#10;run_categorize.py:16-23, run_proposal_diff.py:27-34&#10;→ 只有第一次有效，行為依 import 順序而定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="640" height="160" as="geometry" />
        </mxCell>

        <mxCell id="i8" value="⚠️ 8 — review 用 LangChain，evaluate / diff 用裸 SDK&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;review：src/llm/review.py:11-13&#10;evaluate：src/evaluation/evaluator.py:13&#10;diff：src/llm/proposal_diff.py:14&#10;→ debug 時要先確認用的是哪條" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="720" y="600" width="640" height="160" as="geometry" />
        </mxCell>

        <mxCell id="i9" value="⚠️ 9 — README 已標明壞掉的腳本仍留著&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;repo 根目錄：&#10;  api_test.py, notebook_api_example.py, simple_api_example.py&#10;src/utils/pycon_api_client.py&#10;→ readme.md:213-215 說明，但檔案還在&#10;→ 新人會誤以為是入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="640" height="160" as="geometry" />
        </mxCell>

        <mxCell id="i10" value="⚠️ 10 — proposal_diff 開兩個 OpenAI client&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;src/llm/proposal_diff.py:37-38&#10;  self.llm_client = OpenAIClient(model=model_name, ...)&#10;  self.translation_client = OpenAIClient(model=translation_model, ...)&#10;→ 沒有 client pool / 共用機制&#10;→ 加更多模型會繼續長新欄位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="720" y="780" width="640" height="160" as="geometry" />
        </mxCell>

        <mxCell id="fix_box" value="🛠️ 建議的整理優先序&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;高優先：⚠️1, 2, 4, 5（架構性問題，越拖越貴）&#10;  → 加 pyproject.toml 把 src 設為 package；刪 sys.path.insert；統一 import；抽 build_llm 工廠&#10;&#10;中優先：⚠️6, 7, 9（誤導性問題，影響新人 onboarding）&#10;  → 刪掉 OPENAI_TEMPERATURE 那行；basicConfig 只在 entry 點呼叫；壞腳本搬到 archive/&#10;&#10;低優先：⚠️3, 8, 10（重構成本高，現狀可運作）&#10;  → 統一到單一 client 抽象，但需要全面測試" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="980" width="1300" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
